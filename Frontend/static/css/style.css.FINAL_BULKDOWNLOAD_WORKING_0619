    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.4s ease;
}

#downloadSelectedBtn:hover:not(:disabled) {
    background: linear-gradient(135deg, #047857, #059669);
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(16, 185, 129, 0.4);
}

#downloadSelectedBtn:hover::before {
    left: 100%;
}

#downloadSelectedBtn:disabled {
    background: #9ca3af;
    cursor: not-allowed;
    opacity: 0.6;
    transform: none;
    box-shadow: none;
}

#downloadSelectedBtn:disabled::before {
    display: none;
}

/* Individual Download Checkbox Container */
.download-checkbox-container {
    background: rgba(255, 255, 255, 0.25);
    border-radius: 8px;
    padding: 6px 10px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.download-checkbox-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.6s ease;
}

.download-checkbox-container:hover {
    background: rgba(255, 255, 255, 0.35);
    border-color: rgba(255, 255, 255, 0.6);
    transform: translateY(-1px);
}

.download-checkbox-container:hover::before {
    left: 100%;
}

/* Individual download checkboxes */
.download-checkbox-container input[type="checkbox"] {
    width: 16px;
    height: 16px;
    accent-color: #10b981;
    cursor: pointer;
    transition: all 0.3s ease;
}

.download-checkbox-container input[type="checkbox"]:hover {
    transform: scale(1.1);
}

.download-checkbox-container input[type="checkbox"]:focus {
    outline: 2px solid rgba(255, 255, 255, 0.8);
    outline-offset: 2px;
}

/* Selected Scripts Summary */
#selectedScriptsSummary {
    background: rgba(255, 255, 255, 0.7);
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    padding: 12px 15px;
    margin-top: 15px;
    font-size: 0.85rem;
    color: #475569;
    transition: all 0.3s ease;
    animation: fadeInUp 0.3s ease-out;
}

#selectedScriptsSummary:hover {
    background: rgba(255, 255, 255, 0.9);
    border-color: #94a3b8;
}

/* Bulk Actions Container */
.bulk-actions-container {
    text-align: center;
    margin: 20px 0;
    animation: fadeInUp 0.6s ease-out;
}

#showBulkDownloadBtn {
    background: linear-gradient(135deg, #64748b, #475569);
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(100, 116, 139, 0.3);
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
}

#showBulkDownloadBtn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.5s ease;
}

#showBulkDownloadBtn:hover {
    background: linear-gradient(135deg, #475569, #334155);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(100, 116, 139, 0.4);
}

#showBulkDownloadBtn:hover::before {
    left: 100%;
}

/* Loading Spinner for Download Button */
.spinner {
    width: 16px;
    height: 16px;
    border: 2px solid transparent;
    border-top: 2px solid currentColor;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    display: inline-block;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

/* Close Button Styling */
.bulk-download-controls button[onclick="hideBulkDownloadControls()"] {
    background: #e2e8f0;
    color: #475569;
    border: 1px solid #cbd5e1;
    padding: 10px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 500;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.bulk-download-controls button[onclick="hideBulkDownloadControls()"]::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(71, 85, 105, 0.1), transparent);
    transition: left 0.4s ease;
}

.bulk-download-controls button[onclick="hideBulkDownloadControls()"]:hover {
    background: #cbd5e1;
    border-color: #94a3b8;
    transform: translateY(-1px);
}

.bulk-download-controls button[onclick="hideBulkDownloadControls()"]:hover::before {
    left: 100%;
}

/* Enhanced animations for bulk download */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes slideInFromTop {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes pulseGlow {
    0% {
        box-shadow: 0 4px 15px rgba(100, 116, 139, 0.15);
    }
    50% {
        box-shadow: 0 8px 25px rgba(100, 116, 139, 0.3);
    }
    100% {
        box-shadow: 0 4px 15px rgba(100, 116, 139, 0.15);
    }
}

/* Visual feedback for selection changes */
.bulk-download-controls.selection-changed {
    animation: pulseGlow 0.6s ease-out;
}

/* Responsive Design for Bulk Download */
@media (max-width: 768px) {
    .bulk-download-controls {
        padding: 15px;
    }

    .bulk-download-controls > div:first-child {
        flex-direction: column;
        gap: 15px;
        align-items: stretch;
    }

    .bulk-download-controls > div:first-child > div:first-child {
        flex-direction: column;
        gap: 10px;
    }

    .bulk-download-controls > div:last-child {
        justify-content: center;
        width: 100%;
    }

    #downloadCountDisplay {
        text-align: center;
        margin: 0;
    }

    #downloadSelectedBtn {
        width: 100%;
        justify-content: center;
        margin-bottom: 10px;
    }

    .download-checkbox-container {
        margin-bottom: 8px;
        padding: 8px 12px;
    }

    #selectedScriptsSummary {
        font-size: 0.8rem;
        padding: 10px 12px;
    }

    #showBulkDownloadBtn {
        width: 90%;
        max-width: 300px;
        justify-content: center;
    }
}

@media (max-width: 480px) {
    .bulk-download-controls {
        padding: 12px;
        margin-bottom: 20px;
    }

    .bulk-download-controls label {
        font-size: 0.9rem;
    }

    #downloadCountDisplay {
        font-size: 0.8rem;
        padding: 6px 12px;
    }

    #downloadSelectedBtn {
        padding: 12px 16px;
        font-size: 0.85rem;
    }

    .download-checkbox-container {
        padding: 6px 8px;
    }

    .download-checkbox-container span {
        font-size: 0.8rem;
    }

    #selectedScriptsSummary {
        font-size: 0.75rem;
        padding: 8px 10px;
    }

    #showBulkDownloadBtn {
        padding: 10px 20px;
        font-size: 0.9rem;
        width: 95%;
    }
}

/* High contrast mode support */
@media (prefers-contrast: high) {
    .bulk-download-controls {
        border-width: 3px;
        border-color: #000;
    }

    .download-checkbox-container {
        border: 2px solid rgba(255, 255, 255, 0.8);
    }

    #downloadSelectedBtn {
        border: 2px solid #000;
    }

    #showBulkDownloadBtn {
        border: 2px solid #000;
    }
}

/* Reduced motion preferences */
@media (prefers-reduced-motion: reduce) {
    .bulk-download-controls,
    .bulk-actions-container,
    #selectedScriptsSummary {
        animation: none;
    }

    .bulk-download-controls::before,
    #downloadCountDisplay::before,
    #downloadSelectedBtn::before,
    .download-checkbox-container::before,
    #showBulkDownloadBtn::before {
        animation: none;
        transition: none;
    }

    .spinner {
        animation: none;
    }
}

/* Dark mode support for bulk download */
@media (prefers-color-scheme: dark) {
    .bulk-download-controls {
        background: linear-gradient(135deg, #1f2937, #374151);
        border-color: #6b7280;
        color: #f9fafb;
    }

    #selectedScriptsSummary {
        background: rgba(31, 41, 55, 0.7);
        border-color: #4b5563;
        color: #d1d5db;
    }

    .bulk-download-controls button[onclick="hideBulkDownloadControls()"] {
        background: #374151;
        color: #d1d5db;
        border-color: #4b5563;
    }

    .bulk-download-controls button[onclick="hideBulkDownloadControls()"]:hover {
        background: #4b5563;
        border-color: #6b7280;
    }
}

/* Focus states for accessibility */
.download-checkbox-container input[type="checkbox"]:focus-visible {
    outline: 3px solid rgba(255, 255, 255, 0.8);
    outline-offset: 2px;
}

#downloadSelectedBtn:focus-visible,
#showBulkDownloadBtn:focus-visible {
    outline: 2px solid rgba(16, 185, 129, 0.5);
    outline-offset: 2px;
}

.bulk-download-controls button:focus-visible {
    outline: 2px solid rgba(100, 116, 139, 0.5);
    outline-offset: 2px;
}

/* Ensure proper z-index stacking for new elements */
.bulk-download-controls {
    z-index: 40;
}

.download-checkbox-container {
    z-index: 25;
}

.bulk-actions-container {
    z-index: 35;
}

/* Success state for download completion */
.bulk-download-controls.download-success {
    border-color: #10b981;
    background: linear-gradient(135deg, #f0fdf4, #dcfce7);
    animation: successPulse 1s ease-out;
}

@keyframes successPulse {
    0% {
        transform: scale(1);
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.15);
    }
    50% {
        transform: scale(1.02);
        box-shadow: 0 8px 25px rgba(16, 185, 129, 0.3);
    }
    100% {
        transform: scale(1);
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.15);
    }
}

/* Error state for download failure */
.bulk-download-controls.download-error {
    border-color: #ef4444;
    background: linear-gradient(135deg, #fef2f2, #fee2e2);
    animation: errorShake 0.5s ease-out;
}

@keyframes errorShake {
    0%, 20%, 40%, 60%, 80% {
        transform: translateX(0);
    }
    10%, 30%, 50%, 70%, 90% {
        transform: translateX(-5px);
    }
    15%, 35%, 55%, 75% {
        transform: translateX(5px);
    }
    100% {
        transform: translateX(0);
    }
}

/* Utility classes for bulk download states */
.bulk-download-hidden {
    display: none !important;
}

.bulk-download-visible {
    display: block !important;
}

.bulk-download-loading {
    pointer-events: none;
    opacity: 0.7;
}

.bulk-download-disabled {
    opacity: 0.5;
    pointer-events: none;
    cursor: not-allowed;
}

/* Performance optimizations */
.bulk-download-controls,
#downloadSelectedBtn,
#showBulkDownloadBtn,
.download-checkbox-container {
    will-change: transform;
}